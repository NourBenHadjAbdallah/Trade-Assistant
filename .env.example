# Copy this file to .env and fill in your values. .env is git-ignored: never commit it.
# On Render, set the same names under Environment instead.

# Telegram bot (app.py): token from @BotFather
TELEGRAM_TOKEN=
# Any long random string; protects the /cron endpoint
CRON_SECRET=

# News (news_alerts.py): optional CryptoCompare key for more sources
CRYPTOCOMPARE_KEY=
NEWS_TZ=Africa/Tunis

# AI coach. Ollama (local, free) is the default; Claude is optional.
# Claude with a Pro/Max subscription: install Claude Code and run `claude` once to sign in. No key needed.
# Claude pay-per-use instead: put an API key here (it takes priority over the subscription).
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5
# Local Ollama coach
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b
